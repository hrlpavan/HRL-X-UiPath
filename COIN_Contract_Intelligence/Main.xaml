      <Variable x:TypeArguments="sd:DataTable" Name="dt_Contracts" />
      <Variable x:TypeArguments="sd:DataTable" Name="dt_ReviewResults" />
      <Variable x:TypeArguments="x:String" Name="str_SummaryReport" />
      <Variable x:TypeArguments="x:String" Name="str_ContractID" />
      <Variable x:TypeArguments="x:String" Name="str_ContractText" />
      <Variable x:TypeArguments="x:String" Name="str_Borrower" />
      <Variable x:TypeArguments="x:String" Name="str_LoanAmount" />
      <Variable x:TypeArguments="x:String" Name="str_InterestRate" />
      <Variable x:TypeArguments="x:String" Name="str_RepaymentPeriod" />
