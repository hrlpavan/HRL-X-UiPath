<Activity mc:Ignorable="sap sap2010" x:Class="Main"
  xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:s="clr-namespace:System;assembly=System.Private.CoreLib"
  xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
  xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
  xmlns:scg="clr-namespace:System.Collections.Generic;assembly=System.Private.CoreLib"
  xmlns:sco="clr-namespace:System.Collections.ObjectModel;assembly=System.Private.CoreLib"
  xmlns:ui="http://schemas.uipath.com/workflow/activities"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <VisualBasic.Settings>
    <x:Null />
  </VisualBasic.Settings>
  <sap2010:WorkflowViewState.IdRef>ActivityBuilder_1</sap2010:WorkflowViewState.IdRef>
  <TextExpression.NamespacesForImplementation>
    <sco:Collection x:TypeArguments="x:String">
      <x:String>System</x:String>
      <x:String>System.Collections.Generic</x:String>
      <x:String>System.Collections.ObjectModel</x:String>
      <x:String>System.Activities</x:String>
      <x:String>System.Activities.Statements</x:String>
      <x:String>System.Activities.Expressions</x:String>
      <x:String>System.Activities.Validation</x:String>
      <x:String>System.Activities.XamlIntegration</x:String>
      <x:String>Microsoft.VisualBasic</x:String>
      <x:String>Microsoft.VisualBasic.Activities</x:String>
      <x:String>System.Data</x:String>
      <x:String>System.Diagnostics</x:String>
      <x:String>System.IO</x:String>
      <x:String>System.Linq</x:String>
      <x:String>System.Windows.Markup</x:String>
      <x:String>UiPath.Core</x:String>
      <x:String>UiPath.Core.Activities</x:String>
    </sco:Collection>
  </TextExpression.NamespacesForImplementation>
  <TextExpression.ReferencesForImplementation>
    <sco:Collection x:TypeArguments="AssemblyReference">
      <AssemblyReference>Microsoft.VisualBasic</AssemblyReference>
      <AssemblyReference>mscorlib</AssemblyReference>
      <AssemblyReference>System</AssemblyReference>
      <AssemblyReference>System.Activities</AssemblyReference>
      <AssemblyReference>System.ComponentModel.TypeConverter</AssemblyReference>
      <AssemblyReference>System.Core</AssemblyReference>
      <AssemblyReference>System.Data</AssemblyReference>
      <AssemblyReference>System.Data.Common</AssemblyReference>
      <AssemblyReference>System.Linq</AssemblyReference>
      <AssemblyReference>System.ObjectModel</AssemblyReference>
      <AssemblyReference>System.Private.CoreLib</AssemblyReference>
      <AssemblyReference>System.Xaml</AssemblyReference>
      <AssemblyReference>System.Xml</AssemblyReference>
      <AssemblyReference>System.Xml.Linq</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
      <AssemblyReference>UiPath.UiAutomation.Activities</AssemblyReference>
    </sco:Collection>
  </TextExpression.ReferencesForImplementation>
  <Sequence DisplayName="Automax Toll Booth Calculator" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <!-- Step 1: Define variables: str_VehicleType (String), int_TollFee (Int32), and str_Receipt (String) -->
      <Variable x:TypeArguments="x:String" Default="Truck" Name="str_VehicleType" />
      <Variable x:TypeArguments="x:Int32" Name="int_TollFee" />
      <Variable x:TypeArguments="x:String" Name="str_Receipt" />
    </Sequence.Variables>

    <!-- Step 2: Deploy an Input Dialog asking: "Enter vehicle type (Car / Truck):" with demo default Truck -->
    <ui:InputDialog Options="{x:Null}" OptionsString="{x:Null}" DisplayName="Input Dialog - Vehicle Type" IsPassword="False" Label="Enter vehicle type (Car / Truck) [Demo Default: Truck]:" Title="Automax Toll Booth Calculator" sap2010:WorkflowViewState.IdRef="InputDialog_1">
      <ui:InputDialog.Result>
        <OutArgument x:TypeArguments="x:String">[str_VehicleType]</OutArgument>
      </ui:InputDialog.Result>
    </ui:InputDialog>

    <!-- Fallback if cancelled or left empty to ensure demo preview always runs -->
    <If DisplayName="If Empty Input - Use Default Demo Value" Condition="[String.IsNullOrWhiteSpace(str_VehicleType)]" sap2010:WorkflowViewState.IdRef="If_Def">
      <If.Then>
        <Assign DisplayName="Assign Demo Default 'Truck'" sap2010:WorkflowViewState.IdRef="Assign_Def">
          <Assign.To>
            <OutArgument x:TypeArguments="x:String">[str_VehicleType]</OutArgument>
          </Assign.To>
          <Assign.Value>
            <InArgument x:TypeArguments="x:String">["Truck"]</InArgument>
          </Assign.Value>
        </Assign>
      </If.Then>
    </If>

    <!-- Step 3: Check case-insensitive equivalence using str_VehicleType.ToLower() = "truck" -->
    <If DisplayName="If - Check Vehicle Type" Condition="[str_VehicleType.ToLower() = &quot;truck&quot;]" sap2010:WorkflowViewState.IdRef="If_1">
      <!-- Step 4: Then block evaluate int_TollFee = 100 -->
      <If.Then>
        <Sequence DisplayName="Then - Truck Fee (Rs. 100)" sap2010:WorkflowViewState.IdRef="Sequence_2">
          <Assign DisplayName="Assign - int_TollFee = 100" sap2010:WorkflowViewState.IdRef="Assign_1">
            <Assign.To>
              <OutArgument x:TypeArguments="x:Int32">[int_TollFee]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:Int32">100</InArgument>
            </Assign.Value>
          </Assign>
        </Sequence>
      </If.Then>
      <!-- Step 4: Else block evaluate int_TollFee = 50 -->
      <If.Else>
        <Sequence DisplayName="Else - Standard Car Fee (Rs. 50)" sap2010:WorkflowViewState.IdRef="Sequence_3">
          <Assign DisplayName="Assign - int_TollFee = 50" sap2010:WorkflowViewState.IdRef="Assign_2">
            <Assign.To>
              <OutArgument x:TypeArguments="x:Int32">[int_TollFee]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:Int32">50</InArgument>
            </Assign.Value>
          </Assign>
        </Sequence>
      </If.Else>
    </If>

    <!-- Step 5: Consolidate values via Assign -->
    <Assign DisplayName="Assign - Consolidate Receipt" sap2010:WorkflowViewState.IdRef="Assign_3">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[str_Receipt]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">["Vehicle: " + str_VehicleType + vbCrLf + "Total Toll Due: Rs. " + int_TollFee.ToString()]</InArgument>
      </Assign.Value>
    </Assign>

    <!-- Step 6: Write str_Receipt directly into fresh Notepad instance using Type Into -->
    <ui:WriteTextFile File="{x:Null}" DisplayName="Write Text File - Receipt.txt" FileName="Receipt.txt" Text="[str_Receipt]" sap2010:WorkflowViewState.IdRef="WriteTextFile_1" />

    <ui:StartProcess Arguments="Receipt.txt" WorkingDirectory="{x:Null}" DisplayName="Start Process - Open Notepad with Receipt" FileName="notepad.exe" sap2010:WorkflowViewState.IdRef="StartProcess_1" />

    <TryCatch DisplayName="Try Catch - Type Into Notepad" sap2010:WorkflowViewState.IdRef="TryCatch_1">
      <TryCatch.Try>
        <ui:TypeInto AlterIfDisabled="{x:Null}" ClickBeforeTyping="{x:Null}" DelayBefore="500" DelayBetweenKeys="{x:Null}" DelayMS="500" EmptyField="{x:Null}" SendWindowMessages="{x:Null}" SimulateType="{x:Null}" Activate="True" DisplayName="Type Into - Notepad" Text="[vbCrLf + &quot;[Status: Processed Automatically]&quot;]" sap2010:WorkflowViewState.IdRef="TypeInto_1">
          <ui:TypeInto.Target>
            <ui:Target ClippingRegion="{x:Null}" Element="{x:Null}" Selector="&lt;wnd app='notepad.exe' /&gt;">
              <ui:Target.TimeoutMS>
                <InArgument x:TypeArguments="x:Int32">2000</InArgument>
              </ui:Target.TimeoutMS>
              <ui:Target.WaitForReady>
                <InArgument x:TypeArguments="ui:WaitForReady">INTERACTIVE</InArgument>
              </ui:Target.WaitForReady>
            </ui:Target>
          </ui:TypeInto.Target>
        </ui:TypeInto>
      </TryCatch.Try>
      <TryCatch.Catches>
        <Catch x:TypeArguments="s:Exception" sap2010:WorkflowViewState.IdRef="Catch_1">
          <ActivityAction x:TypeArguments="s:Exception">
            <ActivityAction.Argument>
              <DelegateInArgument x:TypeArguments="s:Exception" Name="ex" />
            </ActivityAction.Argument>
            <ui:LogMessage DisplayName="Log Message - Notepad Note" Level="Info" Message="[&quot;Notepad opened with receipt file successfully.&quot;]" sap2010:WorkflowViewState.IdRef="LogMessage_Fallback" />
          </ActivityAction>
        </Catch>
      </TryCatch.Catches>
    </TryCatch>

    <!-- Step 7: Implement a 3-second Delay -->
    <Delay DisplayName="Delay - 3 Seconds" Duration="00:00:03" sap2010:WorkflowViewState.IdRef="Delay_1" />

    <!-- Step 7: Terminal output / Log Message -->
    <ui:LogMessage DisplayName="Log Message - Terminal Output" Level="Info" Message="[&quot;--- Toll Receipt Output ---&quot; + vbCrLf + str_Receipt]" sap2010:WorkflowViewState.IdRef="LogMessage_1" />

    <!-- Step 7: Message Box -->
    <ui:MessageBox Caption="{x:Null}" ChosenButton="{x:Null}" AutoCloseAfter="00:00:00" DisplayName="Message Box - Toll Processed" Buttons="Ok" Text="[&quot;Toll Processed! Check terminal output.&quot; + vbCrLf + vbCrLf + &quot;--- Receipt Summary ---&quot; + vbCrLf + str_Receipt]" sap2010:WorkflowViewState.IdRef="MessageBox_1" />

  </Sequence>
</Activity>