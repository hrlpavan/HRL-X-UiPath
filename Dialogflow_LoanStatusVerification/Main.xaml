      <!-- Populate sample database records -->
      <ui:AddDataRow ArrayRow="[{&quot;8841&quot;, &quot;Under Review&quot;}]" DataTable="[dt_LoanDatabase]" DisplayName="Insert 8841" sap:VirtualizedContainerService.HintSize="388,52" sap2010:WorkflowViewState.IdRef="AddDataRow_1" />
      <ui:AddDataRow ArrayRow="[{&quot;8842&quot;, &quot;Approved&quot;}]" DataTable="[dt_LoanDatabase]" DisplayName="Insert 8842" sap:VirtualizedContainerService.HintSize="388,52" sap2010:WorkflowViewState.IdRef="AddDataRow_2" />
      <ui:AddDataRow ArrayRow="[{&quot;8843&quot;, &quot;Rejected&quot;}]" DataTable="[dt_LoanDatabase]" DisplayName="Insert 8843" sap:VirtualizedContainerService.HintSize="388,52" sap2010:WorkflowViewState.IdRef="AddDataRow_3" />

