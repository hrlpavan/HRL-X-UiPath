        <Assign.Value>
          <InArgument x:TypeArguments="x:String">["What is the status of loan application 8842?"]</InArgument>
        </Assign.Value>
      </Assign>

      <!-- Simulate NLU Intent Identification & Parameter Extraction -->
      <Assign DisplayName="Extract Loan ID Parameter" sap:VirtualizedContainerService.HintSize="388,82" sap2010:WorkflowViewState.IdRef="Assign_ExtractID">
        <Assign.To>
          <OutArgument x:TypeArguments="x:String">[str_TargetLoanID]</OutArgument>
        </Assign.To>
        <Assign.Value>
          <InArgument x:TypeArguments="x:String">["8842"]</InArgument>
        </Assign.Value>
      </Assign>

      <!-- Query Database for Status -->
      <Assign DisplayName="Lookup Status in dt_LoanDatabase" sap:VirtualizedContainerService.HintSize="388,82" sap2010:WorkflowViewState.IdRef="Assign_LookupStatus">
        <Assign.To>
          <OutArgument x:TypeArguments="x:String">[str_TargetStatus]</OutArgument>
