    <!-- Step 2: Primary Expected Result Test (Query 8842) -->
    <Sequence DisplayName="Execute Primary Expected Query (Loan 8842)" sap:VirtualizedContainerService.HintSize="488,450" sap2010:WorkflowViewState.IdRef="Sequence_PrimaryQuery">
      <Assign DisplayName="Set User Query" sap:VirtualizedContainerService.HintSize="388,82" sap2010:WorkflowViewState.IdRef="Assign_Query">
