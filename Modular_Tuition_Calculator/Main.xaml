        <InArgument x:TypeArguments="x:Double" x:Key="in_DiscountRate">[scholarshipPercent]</InArgument>
        <InOutArgument x:TypeArguments="x:Double" x:Key="io_PayableFee">[baseTuitionFee]</InOutArgument>
      </ui:InvokeWorkflowFile.Arguments>
    </ui:InvokeWorkflowFile>
    <ui:LogMessage DisplayName="Log Final Results" sap:VirtualizedContainerService.HintSize="388,141" sap2010:WorkflowViewState.IdRef="LogMessage_3" Level="Info" Message="[&quot;Tuition Calculation Complete. Scholarship Granted: &quot; + isEligible.ToString() + &quot; | Final Payable Fee: $&quot; + baseTuitionFee.ToString()]" />
    <ui:WriteTextFile File="{x:Null}" DisplayName="Save Output Summary" FileName="Tuition_Calculation_Summary.txt" sap:VirtualizedContainerService.HintSize="388,133" sap2010:WorkflowViewState.IdRef="WriteTextFile_1" Text="[&quot;Scholarship Granted: &quot; + isEligible.ToString() + vbCrLf + &quot;Final Payable Fee: $&quot; + baseTuitionFee.ToString()]" />
