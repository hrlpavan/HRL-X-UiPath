        <InArgument x:TypeArguments="x:Double" x:Key="in_StudentGPA">[studentGPA]</InArgument>
        <OutArgument x:TypeArguments="x:Double" x:Key="out_ScholarshipPercent">[scholarshipPercent]</OutArgument>
        <OutArgument x:TypeArguments="x:Boolean" x:Key="out_IsEligible">[isEligible]</OutArgument>
      </ui:InvokeWorkflowFile.Arguments>
    </ui:InvokeWorkflowFile>
    <ui:LogMessage DisplayName="Log Scholarship Outcome" sap:VirtualizedContainerService.HintSize="388,141" sap2010:WorkflowViewState.IdRef="LogMessage_2" Level="Info" Message="[&quot;Scholarship Evaluation: Eligible = &quot; + isEligible.ToString() + &quot; | Discount Rate = &quot; + (scholarshipPercent * 100.0).ToString() + &quot;%&quot;]" />
    <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" ContinueOnError="{x:Null}" DisplayName="Invoke UpdatePayableFee Workflow" sap:VirtualizedContainerService.HintSize="388,113" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_2" UnSafe="False" WorkflowFileName="UpdatePayableFee.xaml">
