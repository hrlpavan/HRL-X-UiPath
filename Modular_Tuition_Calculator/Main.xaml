  <Sequence sap2010:Annotation.AnnotationText="Modular Tuition Calculator Main Controller: Initializes student variables, invokes CalculateScholarship.xaml to determine eligibility &amp; discount rate, invokes UpdatePayableFee.xaml to recalculate net payable tuition, logs execution, writes Tuition_Calculation_Summary.txt, and displays summary via MessageBox." DisplayName="Main Sequence" sap:VirtualizedContainerService.HintSize="450,1150" sap2010:WorkflowViewState.IdRef="Sequence_Main_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:Double" sap2010:Annotation.AnnotationText="Student's GPA (Default: 3.8)." Default="3.8" Name="studentGPA" />
      <Variable x:TypeArguments="x:Double" sap2010:Annotation.AnnotationText="Base tuition fee before scholarship deductions (Default: 10000.0)." Default="10000" Name="baseTuitionFee" />
      <Variable x:TypeArguments="x:Double" sap2010:Annotation.AnnotationText="Calculated scholarship percentage (Default: 0.0)." Default="0" Name="scholarshipPercent" />
      <Variable x:TypeArguments="x:Boolean" sap2010:Annotation.AnnotationText="Scholarship eligibility flag (Default: False)." Default="False" Name="isEligible" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
